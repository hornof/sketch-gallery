{
  "name": "sketch-gallery",
  "version": "0.0.0",
  "private": true,
  "description": "A web gallery of drawings, one page per year.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "build": "node build/build.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "lighthouse": "npx --yes @lhci/cli@0.16.1 autorun",
    "serve": "node tests/serve.mjs dist 4173",
    "fixtures": "node tests/fixtures/make-fixtures.mjs",
    "mutation": "stryker run",
    "try-add": "node tests/try-add.mjs",
    "try-import": "node tests/try-import.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "exifr": "^7.1.3",
    "fast-check": "^4.10.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "qs": "^6.16.1"
  }
}
